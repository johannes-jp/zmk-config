#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &hillside52_physical_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
// | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |                                   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
// | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |                                   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
// | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 / SW19 /                     \ SW19 \ SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
// | SW20 | SW21 | SW22    | SW23 / SW24 / SW25 / SW26 /               \ SW26 \ SW25 \ SW24 \ SW23 |    SW22 | SW21 | SW20 |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(4,5)                   RC(4,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2)         RC(4,1) RC(4,2) RC(4,3) RC(4,4)   RC(4,7) RC(4,8) RC(4,9) RC(4,10)        RC(3,9) RC(3,10) RC(3,11)
        >;
    };

    hillside52_physical_layout: hillside52_physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Hillside 52";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <
            &key_physical_attrs 18 18  0   0  0 0 0
            , <&key_physical_attrs 18 18 19   0  0 0 0>
            , <&key_physical_attrs 18 18 38   0  0 0 0>
            , <&key_physical_attrs 18 18 57   0  0 0 0>
            , <&key_physical_attrs 18 18 76   0  0 0 0>
            , <&key_physical_attrs 18 18 95   0  0 0 0>
            , <&key_physical_attrs 18 18 200  0  0 0 0>
            , <&key_physical_attrs 18 18 219  0  0 0 0>
            , <&key_physical_attrs 18 18 238  0  0 0 0>
            , <&key_physical_attrs 18 18 257  0  0 0 0>
            , <&key_physical_attrs 18 18 276  0  0 0 0>
            , <&key_physical_attrs 18 18 295  0  0 0 0>
            , <&key_physical_attrs 18 18  0  19  0 0 0>
            , <&key_physical_attrs 18 18 19  19  0 0 0>
            , <&key_physical_attrs 18 18 38  19  0 0 0>
            , <&key_physical_attrs 18 18 57  19  0 0 0>
            , <&key_physical_attrs 18 18 76  19  0 0 0>
            , <&key_physical_attrs 18 18 95  19  0 0 0>
            , <&key_physical_attrs 18 18 200 19  0 0 0>
            , <&key_physical_attrs 18 18 219 19  0 0 0>
            , <&key_physical_attrs 18 18 238 19  0 0 0>
            , <&key_physical_attrs 18 18 257 19  0 0 0>
            , <&key_physical_attrs 18 18 276 19  0 0 0>
            , <&key_physical_attrs 18 18 295 19  0 0 0>
            , <&key_physical_attrs 18 18  0  38  0 0 0>
            , <&key_physical_attrs 18 18 19  38  0 0 0>
            , <&key_physical_attrs 18 18 38  38  0 0 0>
            , <&key_physical_attrs 18 18 57  38  0 0 0>
            , <&key_physical_attrs 18 18 76  38  0 0 0>
            , <&key_physical_attrs 18 18 95  38  0 0 0>
            , <&key_physical_attrs 18 18 120 57  0 0 0>
            , <&key_physical_attrs 18 18 220 57  0 0 0>
            , <&key_physical_attrs 18 18 200 38  0 0 0>
            , <&key_physical_attrs 18 18 219 38  0 0 0>
            , <&key_physical_attrs 18 18 238 38  0 0 0>
            , <&key_physical_attrs 18 18 257 38  0 0 0>
            , <&key_physical_attrs 18 18 276 38  0 0 0>
            , <&key_physical_attrs 18 18 295 38  0 0 0>
            , <&key_physical_attrs 18 18  0  57  0 0 0>
            , <&key_physical_attrs 18 18 19  57  0 0 0>
            , <&key_physical_attrs 18 18 38  57  0 0 0>
            , <&key_physical_attrs 18 18 57  57  0 0 0>
            , <&key_physical_attrs 18 18 76  57  0 0 0>
            , <&key_physical_attrs 18 18 95  57  0 0 0>
            , <&key_physical_attrs 18 18 114 57  0 0 0>
            , <&key_physical_attrs 18 18 240 57  0 0 0>
            , <&key_physical_attrs 18 18 259 57  0 0 0>
            , <&key_physical_attrs 18 18 278 57  0 0 0>
            , <&key_physical_attrs 18 18 297 57  0 0 0>
            , <&key_physical_attrs 18 18 316 57  0 0 0>
            , <&key_physical_attrs 18 18 335 57  0 0 0>
            , <&key_physical_attrs 18 18 354 57  0 0 0>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

//    left_encoder: encoder_left {
//            compatible = "alps,ec11";
//            label = "LEFT_ENCODER";
//            a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
//            b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
//            resolution = <4>;
//            status = "disabled";
//        };
//
//    right_encoder: encoder_right {
//            compatible = "alps,ec11";
//            label = "RIGHT_ENCODER";
//            a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
//            b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
//            resolution = <4>;
//            status = "disabled";
//        };
//
